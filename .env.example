# Leave blank to run in MOCK mode (fake data, canned AI). Fill in for real sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From developer.paypal.com > your app > Webhooks (point it at https://<your-app>/api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PORT=3000

# Optional: keep state across restarts. Use one. On Render the blueprint sets REDIS_URL from Key Value.
REDIS_URL=
DATA_FILE=

# Optional: Channel3 product catalog for "not as described" disputes (trychannel3.com). Demo facts are used without it.
CHANNEL3_API_KEY=
