{
  "name": "sellershield",
  "version": "0.1.0",
  "description": "AI agent that protects small sellers' money on PayPal: disputes, held funds, unpaid invoices.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "bench": "node bench/run.js",
    "test": "node --test test/*.test.js",
    "record-demo": "node scripts/record-demo.cjs",
    "apimatic:validate": "apimatic api validate -i apimatic",
    "apimatic:sdk": "apimatic sdk generate -l typescript -i apimatic",
    "apimatic:portal": "apimatic portal generate -i apimatic",
    "apimatic:plugin": "apimatic plugin generate -i apimatic"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@bryntum/scheduler-trial": "^7.3.8",
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ag-charts-community": "^10.3.3",
    "ag-grid-community": "^32.3.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  }
}
